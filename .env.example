# Copy to .env. Locations and pins. Nothing here is secret.
# Unset values keep the Makefile defaults.

BIND=127.0.0.1

# Parent of ovms/, ollama/ and llama/. Uncomment to move the whole tree.
# MODELS_DIR=/home/you/.local-llm-serve
# One service, when its weights already live somewhere else:
# OVMS_DIR=/home/you/.local-llm-serve/ovms
# OLLAMA_DIR=/home/you/.local-llm-serve/ollama
# LLAMA_DIR=/home/you/.local-llm-serve/llama

OVMS_IMAGE=openvino/model_server:2026.4.0-gpu
OVMS_PORT=11551

OLLAMA_IMAGE=ollama/ollama:0.34.3
OLLAMA_PORT=11439
# Slots, and the context at which embeddings truncate with no error.
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_DEBUG=0

# llama.cpp images. A catalog entry's backend picks one. BACKEND= on llama-up overrides it.
LLAMA_IMAGE_SYCL=ghcr.io/ggml-org/llama.cpp:server-intel
LLAMA_IMAGE_VULKAN=ghcr.io/ggml-org/llama.cpp:server-vulkan

# Model pulls from inside the containers, and the gte conversion on the host.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1
